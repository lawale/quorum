# Static file server for the built site. The public Caddy in front of the
# demo stack terminates TLS and routes the API paths to the Quorum server.
:80 {
	root * /srv
	encode zstd gzip
	try_files {path} {path}/ {path}.html
	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
	file_server
}
