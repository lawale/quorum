<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Quorum.Client.MediatR</PackageId>
    <Description>Route MediatR commands through Quorum for approval: mark a command, and it is held until a checker approves it, then dispatched to its handler unchanged.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://quorum.olawalelawal.dev</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>quorum;approval;maker-checker;four-eyes;mediatr;cqrs</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>Quorum.Client.MediatR</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Quorum.Client.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Quorum.Client/Quorum.Client.csproj" />
    <PackageReference Include="MediatR" Version="14.2.0" />
  </ItemGroup>

</Project>
